# LearnAIRight (Learn AI Right — with Tru) — copy to .env.local and fill in. NEVER commit real keys.
# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Stripe (PLACEHOLDER — get from https://dashboard.stripe.com/apikeys ; use TEST keys first)
STRIPE_SECRET_KEY=sk_test_placeholder_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_replace_me
# Create a recurring Price in Stripe Dashboard > Products (suggested product name: "LearnAIRight Premium"), paste its id:
STRIPE_PRICE_ID=price_placeholder_replace_me
# From Stripe CLI (`stripe listen`) or Dashboard webhook endpoint:
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_me
# Admin auth (REQUIRED before any public deploy)
# Password for /admin/login, which gates /admin/* and GET /api/sponsors.
# Generate a strong one, e.g.: openssl rand -base64 32
# Local: put the real value in .env.local (gitignored). Production: set the
# same variable name in Vercel > Project > Settings > Environment Variables.
# If unset, admin fails closed: login shows "admin not configured" and no
# sponsor data is ever shown.
ADMIN_PASSWORD=
# Optional: secret for signing user session cookies (learnairight_user).
# If unset, falls back to ADMIN_PASSWORD, then to a local-dev-only constant.
# Set a real random value before any public launch, e.g. openssl rand -base64 32
USER_SESSION_SECRET=
