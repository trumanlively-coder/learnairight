# LearnAIRight — copy to .env.local and fill in. NEVER commit real keys.
# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe TEST MODE ONLY (this build refuses live keys) ---
# 1. Create a free Stripe account at https://dashboard.stripe.com/register and stay in TEST mode
#    (toggle "Test mode" ON). Keys: https://dashboard.stripe.com/test/apikeys
#    Secret must start sk_test_ and publishable pk_test_ — sk_live_/pk_live_ will throw
#    "Live keys not allowed in this build" at checkout.
STRIPE_SECRET_KEY=sk_test_placeholder_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_replace_me
# Legacy name also accepted for the publishable key:
# STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_replace_me
#
# 2. In TEST mode, Dashboard > Products > Add product — create exactly:
#    - "LearnAIRight Single Module Pass" — one-time price $29.00 USD -> copy its price_... id:
STRIPE_PRICE_SINGLE=price_placeholder_replace_me
#    - "LearnAIRight All-Access Bundle" — one-time price $99.00 USD (includes Premium) -> price_... id:
STRIPE_PRICE_BUNDLE=price_placeholder_replace_me
#    With secret + both price ids set, /api/modules/purchase opens real Stripe TEST
#    Checkout (test card 4242 4242 4242 4242, any future expiry, any CVC). Without
#    them, checkout stays a clearly-labelled mock unlock (no card, no charge).
#
# 3. (Optional, existing Premium subscription flow) suggested product:
#    "LearnAIRight Premium" — recurring price (e.g. $79/yr placeholder) -> price_... id:
STRIPE_PRICE_ID=price_placeholder_replace_me
#
# 4. Webhook secret (grants entitlements on checkout.session.completed, verified):
#    Local: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints whsec_...
#    Hosted: Dashboard (test mode) > Developers > Webhooks > add endpoint
#    <your-url>/api/stripe/webhook for checkout.session.completed, copy its whsec_...
#    If unset locally, the /modules/success page still verifies the session
#    server-side with the secret key and grants idempotently.
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_me

# Admin auth (REQUIRED before any public deploy)
# Password for /admin/login, which gates /admin/* and GET /api/sponsors.
# Generate a strong one, e.g.: openssl rand -base64 32
# Local: put the real value in .env.local (gitignored). Production: set the
# same variable name in Vercel > Project > Settings > Environment Variables.
# If unset, admin fails closed: login shows "admin not configured" and no
# sponsor data is ever shown.
ADMIN_PASSWORD=
# Optional: secret for signing user session cookies (learnairight_user).
# If unset, falls back to ADMIN_PASSWORD, then to a local-dev-only constant.
# Set a real random value before any public launch, e.g. openssl rand -base64 32
USER_SESSION_SECRET=
